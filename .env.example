# SenseNova Present deployment configuration
# Copy to .env. Shell variables override this file; CLI flags override both.

# WebUI
STUDIO_LANGUAGE=zh
SENSE_NOVA_LOCAL_HOST=127.0.0.1
SENSE_NOVA_LOCAL_PORT=8001
STUDIO_EDITION=v1
STUDIO_DATA_DIR=./studio/data
# macOS only: prevent idle sleep while long generation jobs are running.
# Closing the laptop lid can still suspend the system.
SENSENOVA_KEEP_AWAKE=1

# This release uses the internal sn-ppt-web Harness, displays one
# sn-ppt-web entry, and routes each query to frozen sn-ppt-web-zh/en Skills.
PPTAGENT_PUBLIC_SKILL_KEYS=sn-ppt-web
PPTAGENT_DEFAULT_SKILL=sn-ppt-web
# Usually auto-detected from ./bundled/static-ppt-skill-suite. Override only
# when maintaining the Skill/Harness outside this package.
# PPTAGENT_SN_PPT_WEB_SUITE_ROOT=/absolute/path/to/static-ppt-skill-suite

# Built-in test models are hidden in the release. Leave this empty unless you
# intentionally maintain an internal registry in studio/app/engine.py.
PPTAGENT_PUBLIC_MODEL_KEYS=

# Main text/model service (optional deployment-managed model).
# A complete URL + name pair adds one independent model to the WebUI; it never
# overwrites or renames another model. You can also add/delete models in WebUI
# -> User -> Model configuration.
# SENSENOVA_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# SENSENOVA_MODEL_API_KEY=EMPTY
# SENSENOVA_MODEL_NAME=my-multimodal-model
# SENSENOVA_MODEL_DISPLAY_NAME=My multimodal model

# Image generation provider: openai_images (default) or sensenova_u1.
# SENSENOVA_IMAGE_PROVIDER=openai_images
# SENSENOVA_IMAGE_BASE_URL=https://example.com/v1
# SENSENOVA_IMAGE_API_KEY=sk-REPLACE_ME
# SENSENOVA_IMAGE_MODEL=gpt-image-2-adobe-2

# SenseNova U1 via the native Images API
# SENSENOVA_IMAGE_PROVIDER=sensenova_u1
# SENSENOVA_IMAGE_BASE_URL=https://token.sensenova.cn/v1
# SENSENOVA_IMAGE_API_KEY=REPLACE_ME
# SENSENOVA_IMAGE_MODEL=sensenova-u1-fast

# Search (Serper compatible)
# SENSENOVA_SEARCH_BASE_URL=https://google.serper.dev
# SENSENOVA_SEARCH_API_KEY=REPLACE_ME

# Runtime tuning
STUDIO_AGENT_MAX_TOKENS=40960
STUDIO_MAX_PER_MODEL=0
STUDENT_TEMPERATURE=0.3
